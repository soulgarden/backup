{
  "type": "object",
  "properties": {
    "format_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}Z-[a-f0-9]{32}$"
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "archive_key": {
      "type": "string",
      "minLength": 1
    },
    "archive_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dump_started_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|\\+00:00)$"
    },
    "dump_finished_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|\\+00:00)$"
    },
    "verification_finished_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|\\+00:00)$"
    },
    "image_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "dump_major": {
      "const": 16
    },
    "required_restore_major": {
      "const": 16
    },
    "target_server_major": {
      "const": 16
    },
    "configuration_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includeSchemas",
        "excludeSchemas",
        "excludeTables",
        "excludeTableData",
        "includeLargeObjects",
        "includeAcl",
        "strictNames",
        "compressionLevel"
      ],
      "properties": {
        "includeSchemas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludeSchemas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludeTables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludeTableData": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "includeLargeObjects": {
          "type": "boolean"
        },
        "includeAcl": {
          "type": "boolean"
        },
        "strictNames": {
          "type": "boolean"
        },
        "compressionLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      }
    },
    "checks": {
      "type": "object",
      "properties": {
        "toc": {
          "type": "object",
          "properties": {
            "table_data_entries": {
              "type": "integer",
              "minimum": 0
            },
            "required_objects_checked": {
              "const": true
            }
          },
          "required": [
            "table_data_entries",
            "required_objects_checked"
          ],
          "additionalProperties": false
        },
        "full_archive_read": {
          "const": true
        },
        "remote_sha256": {
          "const": true
        }
      },
      "required": [
        "toc",
        "full_archive_read",
        "remote_sha256"
      ],
      "additionalProperties": false
    },
    "verification_scope": {
      "const": "archive_read_and_remote_sha256"
    },
    "database_restore_tested": {
      "type": "boolean",
      "const": false
    },
    "status": {
      "const": "completed"
    },
    "server_version": {
      "type": "string",
      "minLength": 1
    },
    "pg_dump_version": {
      "type": "string",
      "minLength": 1
    },
    "pg_restore_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "format_version",
    "run_id",
    "database",
    "archive_key",
    "archive_bytes",
    "archive_sha256",
    "dump_started_at",
    "dump_finished_at",
    "verification_finished_at",
    "image_version",
    "dump_major",
    "required_restore_major",
    "target_server_major",
    "configuration_fingerprint",
    "filters",
    "checks",
    "verification_scope",
    "database_restore_tested",
    "status",
    "server_version",
    "pg_dump_version",
    "pg_restore_version"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
